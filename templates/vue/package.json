{
  "name": "fhevm-vue-template",
  "version": "1.0.0",
  "description": "Vue 3 template for FHEVM confidential smart contract applications",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit --skipLibCheck && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "@fhevm/sdk": "workspace:*",
    "ethers": "^6.14.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "^5.2.2",
    "vue-tsc": "^2.0.6",
    "vite": "^5.2.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
